# ---------------------------------------------------------------------------
# BitGoose configuration. Copy to `.env` — never commit `.env`.
# ---------------------------------------------------------------------------

# --- database ---------------------------------------------------------------
DATABASE_URL=postgres://bitgoose:bitgoose@127.0.0.1:55434/bitgoose

# --- http -------------------------------------------------------------------
LEPTOS_SITE_ADDR=127.0.0.1:3000
BG_PUBLIC_BASE_URL=http://127.0.0.1:3000
# Must match the build. cargo-leptos hashes asset filenames, and without this
# the server writes unhashed names into the HTML and every asset 404s.
LEPTOS_HASH_FILES=true

# --- LLM providers ----------------------------------------------------------
# Which provider the Flock uses by default: anthropic | openai | stub
# `stub` is deterministic, offline and free — the pipeline runs fully without keys.
BG_LLM_PROVIDER=stub

# Hosted inference, for when the newsroom should not depend on a laptop.
# The openai_compat provider speaks the protocol Groq, Cerebras, OpenRouter and
# Google's Gemini endpoint all expose, so switching is these three lines and no
# code. Free tiers exist for the first three.
#
#   BG_LLM_PROVIDER=openai_compat
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=<key>
#   BG_MODEL_FAST=llama-3.3-70b-versatile
#
# Cost accounting: only api.openai.com is priced from OpenAI's table. Any other
# host records zero unless you declare the real rate, because inventing a figure
# for an endpoint we do not know would put a false number on /flock.
#
#   BG_LLM_PRICE_IN=0.59     # USD per million input tokens
#   BG_LLM_PRICE_OUT=0.79    # USD per million output tokens

# Per-minute token allowance to plan against. Hosted free tiers meter tokens
# per minute — Groq's is 8,000 — and without this the newsroom fires a pass's
# worth of calls at once, spends the minute in seconds, and then absorbs 429s
# as three blind 75-second sleeps per stage while the site stops updating.
# Waiting before the call costs the same time and gets the work done.
# 0 disables pacing, which is what a paid tier or a local model wants.
BG_LLM_TOKENS_PER_MIN=0

# Comma-separated failover chain, tried left to right.
BG_LLM_FALLBACK=stub

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Any OpenAI-compatible endpoint (OpenAI, Together, vLLM, Ollama, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# For local Ollama instead:
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_API_KEY=ollama

# Per-role model overrides (leave blank to use the built-in tier defaults)
BG_MODEL_FAST=
BG_MODEL_MID=
BG_MODEL_TOP=

# Embeddings are optional. Without one, clustering falls back to SimHash +
# trigram similarity, which works offline. Set to `openai` to enable vectors.
BG_EMBED_PROVIDER=none
BG_EMBED_MODEL=text-embedding-3-small
BG_EMBED_DIM=1536

# --- newsroom tuning --------------------------------------------------------
# Stories scoring at or above this are drafted by the Desk; below go to the Wire.
BG_DESK_THRESHOLD=62
# Max stories the Desk drafts per pipeline run (cost control).
BG_DESK_MAX_PER_RUN=3
# Hard ceiling on spend per pipeline run, USD. 0 disables the check.
BG_RUN_BUDGET_USD=2.00

# --- ingestion --------------------------------------------------------------
# Left unset on purpose. The built-in agent carries a browser product token
# because some publishers' WAFs 403 anything that does not, and /bot is
# generated from whatever this resolves to. Setting it here shadowed the
# built-in with a shorter string, quietly disabling that workaround. Override
# only deliberately:
#   BG_USER_AGENT="MyBot/1.0 (+https://example.com/bot)"

# Feed fetching. The defaults (20s request, 8s connect, 4 concurrent) suit a
# well-connected host. On a constrained uplink they fail quietly: the largest
# feeds time out and the source roster silently shrinks — and concurrency
# divides the bandwidth, so a higher value is actively worse there. Measured,
# the nine sources run 29KB-262KB, so the biggest needs ~26s at 10KB/s.
#   BG_HTTP_TIMEOUT_S=120
#   BG_HTTP_CONNECT_TIMEOUT_S=15
BG_INGEST_CONCURRENCY=4
BG_RESPECT_ROBOTS=true

# --- logging ----------------------------------------------------------------
RUST_LOG=info,bg_agents=debug,bg_ingest=debug,sqlx=warn
